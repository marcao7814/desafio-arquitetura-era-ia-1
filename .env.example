# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
# Vivem só no gateway a partir da v2-decoupled (nunca no serviço app).
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# Chave mestra do AI Gateway (LiteLLM). Não é um segredo real.
GATEWAY_MASTER_KEY=sk-gateway-master-0001

# Chave que a aplicação usa para falar com o gateway.
GATEWAY_API_KEY=sk-gateway-master-0001
GATEWAY_BASE_URL=http://gateway:4000

# Banco de dados do gateway (só o gateway acessa — ver docs/adr/0001-banco-de-dados-do-gateway.md).
# Não é segredo real: só vale para o Postgres local do compose.
POSTGRES_PASSWORD=litellm-fake-pw
DATABASE_URL=postgresql://litellm:litellm-fake-pw@db:5432/litellm
